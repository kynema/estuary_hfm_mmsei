FILE = turbulent-flat-re-180.inp
io.plot_file = "pltAvg"
io.check_file = "chkAvg"

time.stop_time = 0.054590 # ~30 flow-through times for statistics

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             Statistics                #
#.......................................#
incflo.post_processing = sampling
sampling.fields = velocity
sampling.output_interval = 100
sampling.output_format = native

sampling.labels = channel_stats
sampling.channel_stats.type = PlaneSampler
sampling.channel_stats.fields = velocity

sampling.channel_stats.num_points = 1536 768
sampling.channel_stats.origin = 0.0 0.0 -0.005000
sampling.channel_stats.axis1 = 0.031200 0.0 0.0
sampling.channel_stats.axis2 = 0.0 0.015600 0.0

sampling.channel_stats.axis_normal = 2
sampling.channel_stats.start = -0.005000  # Bottom wall Z coordinate
sampling.channel_stats.end = 0.005000  # Top wall Z coordinate

