FILE = ../base-turbulent-flat.inp
time.stop_time = 0.099505 # ~30 flow-through time

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo = 0.0 0.000000 -0.0112500000000000
geometry.prob_hi = 0.062400 0.031200 0.0112500000000000
geometry.is_periodic = 1 1 0

# Boundary conditions
zlo.type =   "no_slip_wall"
zlo.density = 0.468793
zhi.type =   "no_slip_wall"
zhi.density = 0.468793

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.physics = ChannelFlow ChannelBuilder
ICNS.source_terms = BodyForce DragForcing
BodyForce.magnitude = 908.9747500495954000 0.0 0.0 # Force acceleration in m/s^2
DragForcing.is_laminar = 0
ABL.surface_roughness_z0 = 0.00001
DragForcing.terrain_use_original_limiter = false
DragForcing.bc_forcing_time_factor = 1

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#       CHANNEL FLOW PARAMETERS         #
#.......................................#
ChannelFlow.re_tau = 180.0 # For initialization only, same for all cases

# Immersed Boundary Channel Parameters
ChannelBuilder.initialize_velocity = false
ChannelBuilder.zero_velocity_where_blanked = true
ChannelBuilder.initialize_drag_cells = true
ChannelBuilder.segment_labels = s1
ChannelBuilder.s1.type = Trapezoid
ChannelBuilder.s1.segment_start_point = 0.0000 0.015600 0.000000
ChannelBuilder.s1.segment_end_point = 0.062400 0.015600 0.000000
ChannelBuilder.s1.top_width = 0.031200
ChannelBuilder.s1.bottom_width = 0.031200
ChannelBuilder.s1.height = 0.020000

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell = 200 96 72
amr.blocking_factor = 8
amr.max_level = 1

tagging.labels = l1

# Level 1 Refinement (buffer layer, z⁺ ~ 111.1)
tagging.l1.type = GeometryRefinement
tagging.l1.shapes = bottom top
tagging.l1.max_level = 1

tagging.l1.bottom.type = box
tagging.l1.bottom.origin = 0.000000 0.000000 -0.011250
tagging.l1.bottom.xaxis = 0.062400 0.000000 0.000000
tagging.l1.bottom.yaxis = 0.000000 0.031200 0.000000
tagging.l1.bottom.zaxis = 0.000000 0.000000 0.004062

tagging.l1.top.type = box
tagging.l1.top.origin = 0.000000 0.000000 0.007188
tagging.l1.top.xaxis = 0.062400 0.000000 0.000000
tagging.l1.top.yaxis = 0.000000 0.031200 0.000000
tagging.l1.top.zaxis = 0.000000 0.000000 0.004062