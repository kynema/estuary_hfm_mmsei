FILE = turbulent-flat-re-395-ib.inp
io.plot_file = "pltAvg"
io.check_file = "chkAvg"

time.stop_time = 0.132674 # ~40 flow-through times for statistics

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             Statistics                #
#.......................................#
incflo.post_processing = sampling
sampling.fields = velocity
sampling.output_interval = 100
sampling.output_format = native

sampling.labels = channel_stats
sampling.channel_stats.type = PlaneSampler
sampling.channel_stats.fields = velocity

sampling.channel_stats.num_points = 400 192
sampling.channel_stats.origin = 0.0 0.0 -0.010000
sampling.channel_stats.axis1 = 0.062400 0.0 0.0
sampling.channel_stats.axis2 = 0.0 0.031200 0.0

sampling.channel_stats.axis_normal = 2
sampling.channel_stats.start = -0.010000  # Bottom wall Z coordinate
sampling.channel_stats.end = 0.010000  # Top wall Z coordinate

# Define the stack of Z-offsets (82 planes from bottom to top wall)
# Finest grid level: L1 with 82 z-planes
sampling.channel_stats.offset_vector = 0.0 0.0 1.0
