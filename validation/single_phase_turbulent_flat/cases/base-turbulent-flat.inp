#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
time.stop_time =  10.0     # Max (simulated) time to evolve
time.max_step  =  10000    # Max number of time steps

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
#time.fixed_dt  =  0.005            # Use this constant dt if > 0
time.cfl       =  0.95             # CFL factor

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
time.plot_interval            =  100     # Steps between plot files
time.checkpoint_interval      =  1000    # Steps between checkpoint files

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.gravity = 0.0 0.0 0.0 
incflo.density = 0.468793 # Reference density (air at 750K)
incflo.constant_density = true
incflo.use_godunov    = 1
incflo.diffusion_type = 0
incflo.godunov_type = "weno_z"
incflo.physics = ChannelFlow

turbulence.model = Smagorinsky
Smagorinsky_coeffs.Cs = 0.1
transport.viscosity = 3.57816e-5 # dynamic viscosity (air at 750K) Pa.s
transport.laminar_prandtl = 0.7
transport.turbulent_prandtl = 0.3333
transport.reference_temperature = 750.0

ICNS.source_terms = BodyForce
BodyForce.magnitude = 1514.0797750819656358 0.0 0.0 # Force value in m/s^2

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#       CHANNEL FLOW PARAMETERS         #
#.......................................#
ChannelFlow.re_tau = 180.0
ChannelFlow.normal_direction = 2 # z is wall-normal
ChannelFlow.flow_direction = 0
ChannelFlow.perturb_velocity = true
ChannelFlow.perturb_factor = 5.0
#ChannelFlow.perturb_y_period = 4.0
#ChannelFlow.perturb_z_period = 4.0
ChannelFlow.error_log_file = "" 

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#           SOLVER SETTINGS             #
#.......................................#
nodal_proj.mg_atol = 1.0E-8
mac_proj.mg_atol = 1.0E-8


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              VERBOSITY                #
#.......................................#
incflo.verbose = 0 # incflo_level
