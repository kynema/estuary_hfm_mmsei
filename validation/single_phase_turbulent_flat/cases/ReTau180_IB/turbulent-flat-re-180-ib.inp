FILE = ../base-turbulent-flat.inp
time.stop_time = 0.036393 # ~20 flow-through time

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo = 0.0 0.000000 -0.005200
geometry.prob_hi = 0.031200 0.015600 0.005200
geometry.is_periodic = 1 1 0 

# Boundary conditions
zlo.type =   "no_slip_wall"
zlo.density = 0.468793
zhi.type =   "no_slip_wall"
zhi.density = 0.468793

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.physics = ChannelFlow ChannelBuilder
BodyForce.magnitude = 1514.0797750819656358 0.0 0.0

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#       CHANNEL FLOW PARAMETERS         #
#.......................................#
ChannelFlow.re_tau = 180.0

# Immersed Boundary Channel Parameters
ChannelBuilder.initialize_velocity = false
ChannelBuilder.zero_velocity_where_blanked = true
ChannelBuilder.initialize_drag_cells = true
ChannelBuilder.segment_labels = s1
ChannelBuilder.s1.type = Trapezoid
ChannelBuilder.s1.segment_start_point = 0.0000 0.007800 0.000000
ChannelBuilder.s1.segment_end_point = 0.031200 0.007800 0.000000
ChannelBuilder.s1.top_width = 0.015600
ChannelBuilder.s1.bottom_width = 0.015600
ChannelBuilder.s1.height = 0.010000

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
#amr.n_cell = 192 96 60 # Grid cells at coarsest AMR level
amr.n_cell = 96 48 36
amr.blocking_factor = 4
amr.max_level = 1
#amr.n_cell = 384 192 128
#amr.blocking_factor = 8
#amr.max_level = 2

tagging.labels = l1 l2

# Level 1 Refinement (buffer layer, z⁺ ~ 41.0)
tagging.l1.type = GeometryRefinement
tagging.l1.shapes = bottom top
tagging.l1.max_level = 1

tagging.l1.bottom.type = box
tagging.l1.bottom.origin = 0.000000 0.000000 -0.005200
tagging.l1.bottom.xaxis = 0.031200 0.000000 0.000000
tagging.l1.bottom.yaxis = 0.000000 0.015600 0.000000
tagging.l1.bottom.zaxis = 0.000000 0.000000 0.001138

tagging.l1.top.type = box
tagging.l1.top.origin = 0.000000 0.000000 0.004063
tagging.l1.top.xaxis = 0.031200 0.000000 0.000000
tagging.l1.top.yaxis = 0.000000 0.015600 0.000000
tagging.l1.top.zaxis = 0.000000 0.000000 0.001138

# Level 2 Refinement (viscous sublayer, z⁺ ~ 5.8)
tagging.l2.type = GeometryRefinement
tagging.l2.shapes = bottom top
tagging.l2.max_level = 2

tagging.l2.bottom.type = box
tagging.l2.bottom.origin = 0.000000 0.000000 -0.005200
tagging.l2.bottom.xaxis = 0.031200 0.000000 0.000000
tagging.l2.bottom.yaxis = 0.000000 0.015600 0.000000
tagging.l2.bottom.zaxis = 0.000000 0.000000 0.000162

tagging.l2.top.type = box
tagging.l2.top.origin = 0.000000 0.000000 0.005037
tagging.l2.top.xaxis = 0.031200 0.000000 0.000000
tagging.l2.top.yaxis = 0.000000 0.015600 0.000000
tagging.l2.top.zaxis = 0.000000 0.000000 0.000162