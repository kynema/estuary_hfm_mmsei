FILE = turbulent-flat-re-180-ib.inp
io.plot_file = "pltAvg"
io.check_file = "chkAvg"

time.stop_time = 0.054590 # ~30 flow-through times for statistics
#time.stop_time = 0.072786 # ~40 flow-through times for statistics

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#             Statistics                #
#.......................................#
incflo.post_processing = sampling #averaging 

averaging.type = TimeAveraging
averaging.averaging_start_time = 0.036394 # Start after ~20 flow-through time
averaging.labels = means stress
averaging.means.fields = velocity
averaging.means.averaging_type = ReAveraging
averaging.stress.fields = velocity
averaging.stress.averaging_type = ReynoldsStress

sampling.fields = velocity
sampling.output_interval = 100
sampling.output_format = native

sampling.labels = channel_stats
sampling.channel_stats.type = PlaneSampler
sampling.channel_stats.fields = velocity

sampling.channel_stats.num_points = 384 192
sampling.channel_stats.origin = 0.0 0.0 -0.005000
sampling.channel_stats.axis1 = 0.031200 0.0 0.0
sampling.channel_stats.axis2 = 0.0 0.015600 0.0

sampling.channel_stats.axis_normal = 2
sampling.channel_stats.start = -0.005000  # Bottom wall Z coordinate
sampling.channel_stats.end = 0.005000  # Top wall Z coordinate

# Define the stack of Z-offsets (70 planes from bottom to top wall)
# Finest grid level: L1 with 70 z-planes
sampling.channel_stats.offset_vector = 0.0 0.0 1.0
sampling.channel_stats.offsets = 0.000045 0.000134 0.000223 0.000313 0.000402 0.000491 0.000580 0.000670 0.000759 0.000848 0.000937 0.001027 0.001116 0.001205 0.001339 0.001518 0.001696 0.001875 0.002054 0.002232 0.002411 0.002589 0.002768 0.002946 0.003125 0.003304 0.003482 0.003661 0.003839 0.004018 0.004196 0.004375 0.004554 0.004732 0.004911 0.005089 0.005268 0.005446 0.005625 0.005804 0.005982 0.006161 0.006339 0.006518 0.006696 0.006875 0.007054 0.007232 0.007411 0.007589 0.007768 0.007946 0.008125 0.008304 0.008482 0.008661 0.008795 0.008884 0.008973 0.009063 0.009152 0.009241 0.009330 0.009420 0.009509 0.009598 0.009687 0.009777 0.009866 0.009955