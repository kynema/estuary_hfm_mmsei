#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            SIMULATION STOP            #
#.......................................#
time.stop_time =  50.0     # Max (simulated) time to evolve
time.max_step  =  -1   # Max number of time steps

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#         TIME STEP COMPUTATION         #
#.......................................#
time.fixed_dt  =  0.005            # Use this constant dt if > 0
time.cfl       =  0.95             # CFL factor

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#            INPUT AND OUTPUT           #
#.......................................#
time.plot_interval            =  100     # Steps between plot files
time.checkpoint_interval      =  1000    # Steps between checkpoint files

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#               PHYSICS                 #
#.......................................#
incflo.gravity = 0.0 0.0 0.0 
incflo.density = 1.0 # Reference density
incflo.use_godunov = 1
incflo.godunov_type = "weno"
incflo.diffusion_type = 2

transport.viscosity = 1.0e-2
transport.laminar_prandtl = 0.7
transport.turbulent_prandtl = 0.3333
transport.reference_temperature = 300.0

turbulence.model = Laminar

incflo.physics = ChannelBuilder
incflo.velocity = 0.0 0.0 0.0

ICNS.source_terms = DragForcing BodyForce
DragForcing.use_original_drag_limiter = false
DragForcing.use_temporal_drag_limiter = true
BodyForce.magnitude = 0.0565685424949238 0.0 0.0565685424949238 # Force value in m/s^2

# Channel configuration for slanted Poiseuille flow (theta=45 degrees)
# Three periodic segments at 45-degree angles for periodic boundary conditions
amr.n_cell = 32 4 32

ChannelBuilder.segment_labels = s1 s2 s3

ChannelBuilder.s1.flow_speed = 1.0
ChannelBuilder.s1.velocity_profile = Parabolic
ChannelBuilder.s1.type = Trapezoid
ChannelBuilder.s1.top_width_start = 1.0
ChannelBuilder.s1.top_width_end = 1.0
ChannelBuilder.s1.bottom_width_start = 1.0
ChannelBuilder.s1.bottom_width_end = 1.0
ChannelBuilder.s1.height_start = 1.0000
ChannelBuilder.s1.height_end = 1.0000
ChannelBuilder.s1.segment_start_point = 0.0000000000000000 0.031250 0.0000000000000000
ChannelBuilder.s1.segment_end_point = 2.0000000000000000 0.031250 2.0000000000000000

ChannelBuilder.s2.flow_speed = 1.0
ChannelBuilder.s2.velocity_profile = Parabolic
ChannelBuilder.s2.type = Trapezoid
ChannelBuilder.s2.top_width_start = 1.0
ChannelBuilder.s2.top_width_end = 1.0
ChannelBuilder.s2.bottom_width_start = 1.0
ChannelBuilder.s2.bottom_width_end = 1.0
ChannelBuilder.s2.height_start = 1.0000
ChannelBuilder.s2.height_end = 1.0000
ChannelBuilder.s2.segment_start_point = -1.0000000000000000 0.031250 1.0000000000000000
ChannelBuilder.s2.segment_end_point = 1.0000000000000000 0.031250 3.0000000000000000

ChannelBuilder.s3.flow_speed = 1.0
ChannelBuilder.s3.velocity_profile = Parabolic
ChannelBuilder.s3.type = Trapezoid
ChannelBuilder.s3.top_width_start = 1.0
ChannelBuilder.s3.top_width_end = 1.0
ChannelBuilder.s3.bottom_width_start = 1.0
ChannelBuilder.s3.bottom_width_end = 1.0
ChannelBuilder.s3.height_start = 1.0000
ChannelBuilder.s3.height_end = 1.0000
ChannelBuilder.s3.segment_start_point = 1.0000000000000000 0.031250 -1.0000000000000000
ChannelBuilder.s3.segment_end_point = 3.0000000000000000 0.031250 1.0000000000000000

#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#        ADAPTIVE MESH REFINEMENT       #
#.......................................#
amr.n_cell              = 128 4 128   # Grid cells at coarsest AMR level (square 4x4 domain in x-z)
amr.max_level           = 0           # Max AMR level in hierarchy
amr.blocking_factor     = 4


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              GEOMETRY                 #
#.......................................#
geometry.prob_lo     = 0.0 0.000000 0.0
geometry.prob_hi     = 2.0 0.062500 2.0
geometry.is_periodic = 1 1 1 

# Boundary conditions
xlo.density = 1.0
xlo.temperature = 300.0


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#           SOLVER SETTINGS             #
#.......................................#
nodal_proj.mg_atol = 1.0E-8
mac_proj.mg_atol = 1.0E-8


#¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨¨#
#              VERBOSITY                #
#.......................................#
incflo.verbose = 0 # incflo_level
